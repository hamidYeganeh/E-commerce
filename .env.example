# Development only. Bind infrastructure to localhost; replace credentials in production.
DATABASE_URL=postgresql://commerce:commerce_dev_only@127.0.0.1:54329/commerce?schema=public
REDIS_URL=redis://127.0.0.1:63791
QUEUE_REDIS_URL=redis://127.0.0.1:63792
DATABASE_POOL_SIZE=5
LOG_LEVEL=info
WORKER_POLL_INTERVAL_MS=5000
WORKER_BATCH_SIZE=50
# Generate locally: node -e 'console.log(require("crypto").randomBytes(48).toString("base64url"))'
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=
KAVENEGAR_SENDER=
# Optional operational SMS provider. Enable individual rules in admin after configuration.
MELLIPAYAMAK_USERNAME=
MELLIPAYAMAK_PASSWORD=
MELLIPAYAMAK_SENDER=
# Only configure behind a proxy which overwrites this header and protects the origin.
# AUTH_IP_HEADER=x-forwarded-for
# Payment and shipping providers remain disabled.

# Product media. Local storage needs a persistent volume in production.
MEDIA_DRIVER=local
MEDIA_DIRECTORY=.data/media
# For private S3-compatible storage set MEDIA_DRIVER=s3 and these server-only values:
# MEDIA_S3_BUCKET=
# MEDIA_S3_REGION=
# MEDIA_S3_ENDPOINT=
# MEDIA_S3_ACCESS_KEY_ID=
# MEDIA_S3_SECRET_ACCESS_KEY=
# MEDIA_S3_FORCE_PATH_STYLE=true
# Public canonical origin (required when deploying to a real domain).
# NEXT_PUBLIC_SITE_URL=https://shop.example.com

# Checkout stays disabled until provider configuration and reconciliation review.
CHECKOUT_ENABLED=false
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
# Fixed shipping in RIAL; set explicitly, including 0 for free shipping.
SHIPPING_FLAT_RIAL=
