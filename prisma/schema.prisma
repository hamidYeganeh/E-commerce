generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum AttributeType {
  TEXT
  NUMBER
  BOOLEAN
  SELECT
}

enum OrderStatus {
  AWAITING_PAYMENT
  CONFIRMED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  CREATED
  PENDING
  SUCCEEDED
  FAILED
  NEEDS_REVIEW
}

enum ShipmentStatus {
  PENDING
  PACKED
  SHIPPED
  DELIVERED
  RETURNED
}

enum ReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
}

enum StockMovementType {
  RECEIPT
  SALE
  RETURN
  DAMAGE
  ADJUSTMENT
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum RedemptionStatus {
  RESERVED
  CONSUMED
  RELEASED
}

enum RefundStatus {
  REQUESTED
  PROCESSING
  SUCCEEDED
  FAILED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  RESOLVED
}

// Better Auth core, phone login, and staff MFA data.
model User {
  id                  String          @id @default(cuid())
  name                String
  email               String?         @unique
  emailVerified       Boolean         @default(false)
  image               String?
  phoneNumber         String?         @unique
  phoneNumberVerified Boolean         @default(false)
  twoFactorEnabled    Boolean         @default(false)
  disabledAt          DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  restockRequests     RestockRequest[]
  notifications       Notification[]
  walletEntries       WalletEntry[] @relation("WalletOwner")
  walletActions       WalletEntry[] @relation("WalletActor")
  preference          CustomerPreference?
  sessions            Session[]
  accounts            Account[]
  twoFactor           TwoFactor?
  roles               UserRole[]
  addresses           Address[]
  carts               Cart[]
  cartWriteReceipts   CartWriteReceipt[]
  orders              Order[]
  stockMovements      StockMovement[]
  auditLogs           AuditLog[]
  orderEvents         OrderEvent[]
}

model Session {
  id            String    @id @default(cuid())
  token         String    @unique
  expiresAt     DateTime
  ipAddress     String?
  userAgent     String?
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  authMethod    String    @default("CUSTOMER")
  mfaVerifiedAt DateTime?

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
}

model TwoFactor {
  id                      String    @id @default(cuid())
  userId                  String    @unique
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  secret                  String
  backupCodes             String
  verified                Boolean   @default(false)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?
}

model Role {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id    String           @id @default(cuid())
  key   String           @unique
  roles RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Address {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipientName String
  phoneNumber   String
  province      String
  city          String
  addressLine   String
  postalCode    String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

model Brand {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Category {
  id             String              @id @default(cuid())
  name           String
  slug           String              @unique
  description    String?
  seoTitle       String?
  seoDescription String?
  imageKey       String?
  isActive       Boolean             @default(true)
  position       Int                 @default(0)
  parentId       String?
  parent         Category?           @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children       Category[]          @relation("CategoryTree")
  products       ProductCategory[]
  attributes     CategoryAttribute[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([parentId, position])
}

model Tag {
  id             String       @id @default(cuid())
  name           String
  normalizedName String       @unique
  slug           String       @unique
  description    String?
  seoTitle       String?
  seoDescription String?
  isIndexable    Boolean      @default(false)
  products       ProductTag[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Product {
  id             String                  @id @default(cuid())
  name           String
  slug           String                  @unique
  description    String?
  status         ProductStatus           @default(DRAFT)
  brandId        String?
  brand          Brand?                  @relation(fields: [brandId], references: [id], onDelete: Restrict)
  seoTitle       String?
  seoDescription String?
  sourceUrl      String?
  version        Int                     @default(0)
  variants       ProductVariant[]
  categories     ProductCategory[]
  tags           ProductTag[]
  attributes     ProductAttributeValue[]
  media          ProductMedia[]
  batches        Batch[]
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([status, createdAt])
  @@index([brandId])
}

model ProductCategory {
  productId  String
  categoryId String
  isPrimary  Boolean  @default(false)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  // Partial unique index in SQL allows at most one primary category per product.

  @@id([productId, categoryId])
  @@index([categoryId])
}

model ProductTag {
  productId String
  tagId     String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
}

model Attribute {
  id            String                  @id @default(cuid())
  name          String
  key           String                  @unique
  type          AttributeType
  unit          String?
  options       AttributeOption[]
  categories    CategoryAttribute[]
  productValues ProductAttributeValue[]
  variantValues VariantAttributeValue[]
}

model AttributeOption {
  id            String                  @id @default(cuid())
  attributeId   String
  attribute     Attribute               @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value         String
  label         String
  position      Int                     @default(0)
  productValues ProductAttributeValue[]
  variantValues VariantAttributeValue[]

  @@unique([attributeId, value])
  @@unique([id, attributeId])
}

model CategoryAttribute {
  categoryId   String
  attributeId  String
  category     Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attribute    Attribute @relation(fields: [attributeId], references: [id], onDelete: Restrict)
  isRequired   Boolean   @default(false)
  isFilterable Boolean   @default(false)
  isVariant    Boolean   @default(false)
  position     Int       @default(0)

  @@id([categoryId, attributeId])
  @@index([attributeId])
}

model ProductAttributeValue {
  productId   String
  attributeId String
  product     Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute   Attribute        @relation(fields: [attributeId], references: [id], onDelete: Restrict)
  optionId    String?
  option      AttributeOption? @relation(fields: [optionId, attributeId], references: [id, attributeId], onDelete: Restrict)
  value       String?

  @@id([productId, attributeId])
  @@index([optionId, attributeId])
  @@index([attributeId, value])
}

model VariantAttributeValue {
  variantId   String
  attributeId String
  variant     ProductVariant   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attribute   Attribute        @relation(fields: [attributeId], references: [id], onDelete: Restrict)
  optionId    String?
  option      AttributeOption? @relation(fields: [optionId, attributeId], references: [id, attributeId], onDelete: Restrict)
  value       String?

  @@id([variantId, attributeId])
  @@index([optionId, attributeId])
}

model ProductVariant {
  id                  String                  @id @default(cuid())
  productId           String
  product             Product                 @relation(fields: [productId], references: [id], onDelete: Restrict)
  name                String
  sku                 String                  @unique
  barcode             String?                 @unique
  priceRial           BigInt
  netWeightGrams      Int?
  shippingWeightGrams Int?
  isActive            Boolean                 @default(false)
  version             Int                     @default(0)
  lowStockThreshold   Int                     @default(5)
  reorderTarget       Int                     @default(20)
  attributes          VariantAttributeValue[]
  stock               Stock?
  cartItems           CartItem[]
  orderItems          OrderItem[]
  restockRequests     RestockRequest[]
  reservations        StockReservation[]
  stockMovements      StockMovement[]
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@index([productId, isActive])
}

model ProductMedia {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  objectKey String
  alt       String
  position  Int     @default(0)

  @@index([productId, position])
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  isActive  Boolean  @default(true)
  batches   Batch[]
  createdAt DateTime @default(now())
}

model Batch {
  id             String          @id @default(cuid())
  code           String
  productId      String
  product        Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  supplierId     String?
  supplier       Supplier?       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  origin         String?
  producedAt     DateTime?
  expiresAt      DateTime?
  labReportKey   String?
  stockMovements StockMovement[]
  createdAt      DateTime        @default(now())

  @@unique([productId, code])
  @@index([supplierId])
  @@index([expiresAt])
}

model Stock {
  variantId String         @id
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  unitCostRial BigInt?
  onHand    Int            @default(0)
  reserved  Int            @default(0)
  version   Int            @default(0)
  updatedAt DateTime       @updatedAt
}

model StockMovement {
  id           String            @id @default(cuid())
  variantId    String
  variant      ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Restrict)
  batchId      String?
  batch        Batch?            @relation(fields: [batchId], references: [id], onDelete: Restrict)
  orderId      String?
  order        Order?            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  actorId      String?
  actor        User?             @relation(fields: [actorId], references: [id], onDelete: SetNull)
  type         StockMovementType
  quantity     Int
  unitCostRial BigInt?
  reason       String
  eventKey     String            @unique
  createdAt    DateTime          @default(now())

  @@index([variantId, createdAt])
  @@index([batchId])
  @@index([orderId])
  @@index([actorId])
}

model Cart {
  id             String     @id @default(cuid())
  userId         String?
  user           User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityVersion Int      @default(0)
  remindedVersion Int      @default(-1)
  guestTokenHash String?    @unique
  expiresAt      DateTime?
  items          CartItem[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

model CartItem {
  cartId    String
  variantId String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity  Int

  @@id([cartId, variantId])
  @@index([variantId])
}

model CartWriteReceipt {
  userId          String
  key             String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  payloadHash     String
  activityVersion Int
  createdAt       DateTime @default(now())

  @@id([userId, key])
  @@index([createdAt])
}

model Order {
  id               String             @id @default(cuid())
  number           Int                @unique @default(autoincrement())
  userId           String
  user             User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  checkoutKey      String             @unique
  checkoutHash     String
  status           OrderStatus        @default(AWAITING_PAYMENT)
  currency         String             @default("IRR")
  subtotalRial     BigInt
  discountRial     BigInt             @default(0)
  shippingRial     BigInt             @default(0)
  totalRial        BigInt
  giftMessage      String?
  customerNote     String?
  expiresAt        DateTime
  confirmedAt      DateTime?
  cancelledAt      DateTime?
  version          Int                @default(0)
  address          OrderAddress?
  items            OrderItem[]
  reservations     StockReservation[]
  payments         PaymentAttempt[]
  shipments        Shipment[]
  events           OrderEvent[]
  returns          ReturnRequest[]
  couponRedemption CouponRedemption?
  stockMovements   StockMovement[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([status, expiresAt])
}

model OrderAddress {
  orderId       String @id
  order         Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  recipientName String
  phoneNumber   String
  province      String
  city          String
  addressLine   String
  postalCode    String
}

model OrderItem {
  id                  String         @id @default(cuid())
  orderId             String
  order               Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  variantId           String
  variant             ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  productName         String
  variantName         String
  sku                 String
  attributesSnapshot  Json
  quantity            Int
  unitPriceRial       BigInt
  discountRial        BigInt         @default(0)
  totalRial           BigInt
  netWeightGrams      Int?
  shippingWeightGrams Int?
  unitCostRial        BigInt?
  shipmentItems       ShipmentItem[]
  returnItems         ReturnItem[]

  @@index([orderId])
  @@index([variantId])
}

model StockReservation {
  id        String            @id @default(cuid())
  orderId   String
  order     Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  variantId String
  variant   ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity  Int
  status    ReservationStatus @default(ACTIVE)
  expiresAt DateTime
  createdAt DateTime          @default(now())

  @@unique([orderId, variantId])
  @@index([status, expiresAt])
  @@index([variantId])
}

model PaymentAttempt {
  id             String         @id @default(cuid())
  orderId        String
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  provider       String
  authority      String?
  transactionId  String?
  idempotencyKey String         @unique
  status         PaymentStatus  @default(CREATED)
  amountRial     BigInt
  verifiedAt     DateTime?
  failureCode    String?
  events         PaymentEvent[]
  refunds        Refund[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([provider, authority])
  @@unique([provider, transactionId])
  @@index([orderId, createdAt])
  @@index([status, updatedAt])
}

model PaymentEvent {
  id            String         @id @default(cuid())
  paymentId     String
  payment       PaymentAttempt @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  eventKey      String         @unique
  type          String
  sanitizedData Json?
  createdAt     DateTime       @default(now())

  @@index([paymentId, createdAt])
}

model Refund {
  id             String         @id @default(cuid())
  paymentId      String
  payment        PaymentAttempt @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  idempotencyKey String         @unique
  status         RefundStatus   @default(REQUESTED)
  amountRial     BigInt
  reason         String
  providerRef    String?
  returnId       String?
  request        ReturnRequest? @relation(fields: [returnId], references: [id], onDelete: Restrict)
  destination    String @default("MANUAL")
  completedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([paymentId])
}

model Shipment {
  id             String         @id @default(cuid())
  orderId        String
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  status         ShipmentStatus @default(PENDING)
  carrier        String?
  trackingNumber String?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  items          ShipmentItem[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([orderId])
  @@index([status, createdAt])
}

model ShipmentItem {
  shipmentId  String
  orderItemId String
  shipment    Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  quantity    Int

  @@id([shipmentId, orderItemId])
  @@index([orderItemId])
}

model ReturnRequest {
  id        String       @id @default(cuid())
  orderId   String
  order     Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  status    ReturnStatus @default(REQUESTED)
  reason    String
  key       String? @unique
  payloadHash String?
  cancellation Boolean @default(false)
  version   Int @default(0)
  refundLimitRial BigInt @default(0)
  refunds   Refund[]
  items     ReturnItem[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([orderId])
}

model ReturnItem {
  returnId    String
  orderItemId String
  request     ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Restrict)
  orderItem   OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  quantity    Int
  restockable Boolean       @default(false)

  @@id([returnId, orderItemId])
  @@index([orderItemId])
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  type      String
  note      String?
  data      Json?
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
  @@index([actorId])
}

model Coupon {
  firstPurchaseOnly Boolean @default(false)
  productIds      String[] @default([])
  categoryIds     String[] @default([])
  customerIds     String[] @default([])
  version         Int @default(0)
  id              String             @id @default(cuid())
  code            String             @unique
  type            CouponType
  percentage      Int?
  amountRial      BigInt?
  minimumRial     BigInt             @default(0)
  maxDiscountRial BigInt?
  usageLimit      Int?
  perUserLimit    Int                @default(1)
  startsAt        DateTime
  expiresAt       DateTime
  isActive        Boolean            @default(false)
  redemptions     CouponRedemption[]
}

model CouponRedemption {
  id        String           @id @default(cuid())
  couponId  String
  coupon    Coupon           @relation(fields: [couponId], references: [id], onDelete: Restrict)
  orderId   String           @unique
  order     Order            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  status    RedemptionStatus @default(RESERVED)
  createdAt DateTime         @default(now())

  @@index([couponId, status])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String
  requestId  String?
  changes    Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

model OutboxEvent {
  id           String    @id @default(cuid())
  topic        String
  aggregateId  String
  payload      Json
  availableAt  DateTime  @default(now())
  dispatchedAt DateTime?
  processedAt  DateTime?
  attempts     Int       @default(0)
  lastError    String?
  createdAt    DateTime  @default(now())

  @@index([processedAt, availableAt])
  @@index([aggregateId])
}

// Typed commerce modules validate each content kind before storage/publication.
model StoreRecord {
  id          String   @id @default(cuid())
  kind        String
  slug        String
  title       String
  status      String   @default("DRAFT")
  data        Json
  version     Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([kind, slug])
  @@index([kind, status, updatedAt])
}

model Lead {
  id               String   @id @default(cuid())
  name             String
  phone            String
  sourceType       String
  sourceId         String
  message          String?
  marketingConsent Boolean  @default(false)
  status           String   @default("NEW")
  note             String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  @@index([phone, createdAt])
  @@index([status, createdAt])
}

model RestockRequest {
  id        String    @id @default(cuid())
  variantId String
  userId    String
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  sentAt    DateTime?
  createdAt DateTime  @default(now())
  @@unique([variantId, userId])
  @@index([sentAt, variantId])
}

model Notification {
  id          String    @id @default(cuid())
  eventKey    String    @unique
  userId      String?
  phone       String
  user        User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  topic       String
  text        String
  templateValues Json?
  status      String    @default("QUEUED")
  attempts    Int       @default(0)
  availableAt DateTime  @default(now())
  sentAt      DateTime?
  providerRef String?
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  @@index([status, availableAt])
  @@index([userId, createdAt])
}

model WalletEntry {
  id         String   @id @default(cuid())
  userId     String
  user       User @relation("WalletOwner", fields: [userId], references: [id], onDelete: Restrict)
  actor      User? @relation("WalletActor", fields: [actorId], references: [id], onDelete: SetNull)
  amountRial BigInt
  eventKey   String   @unique
  reason     String
  actorId    String?
  createdAt  DateTime @default(now())
  @@index([userId, createdAt])
}

model VisitEvent {
  id          String   @id @default(cuid())
  kind        String
  targetId    String
  visitorHash String
  day         String
  createdAt   DateTime @default(now())
  @@unique([kind, targetId, visitorHash, day])
  @@index([kind, day])
}

model CustomerPreference {
  user             User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           String   @id
  marketingConsent Boolean  @default(false)
  updatedAt        DateTime @updatedAt
}

model StaffInvitation {
  id String @id @default(cuid())
  email String
  name String
  roleKey String
  tokenHash String @unique
  purpose String @default("INVITE")
  userId String?
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())
  @@index([email, expiresAt])
}

model ProductReview {
  id String @id @default(cuid())
  userId String
  productId String
  orderId String
  rating Int
  body String
  status String @default("DRAFT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId, productId])
  @@index([productId, status, createdAt])
}

model InventoryLot {
  id String @id @default(cuid())
  variantId String
  batchId String
  remaining Int
  unitCostRial BigInt
  createdAt DateTime @default(now())
  @@index([variantId, batchId])
}

model OrderItemLot {
  orderItemId String
  lotId String
  quantity Int
  @@id([orderItemId, lotId])
}

model RedirectRule {
  id String @id @default(cuid())
  source String @unique
  destination String
  permanent Boolean @default(true)
  version Int @default(0)
  createdAt DateTime @default(now())
}
