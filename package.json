{
  "name": "honey-commerce",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbo": "next dev --turbopack",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "test:integration": "node --import tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "infra:check": "node --import tsx scripts/check-infrastructure.ts",
    "worker": "node --import tsx src/workers/main.ts",
    "worker:ping": "node --import tsx scripts/worker-ping.ts",
    "test:queue": "node --import tsx --test tests/queue/*.test.ts",
    "build:webpack": "prisma generate && next build --webpack",
    "staff:create": "node --import tsx scripts/create-staff.ts",
    "test:auth": "node --import tsx --test --test-concurrency=1 tests/auth/*.test.ts",
    "test:checkout-concurrency": "node --env-file=.env.local --import tsx scripts/check-checkout-concurrency.ts",
    "ops:backup": "node --import tsx scripts/backup.ts",
    "ops:restore": "node --import tsx scripts/backup.ts --restore",
    "ops:media-preview": "node --import tsx scripts/maintenance.ts",
    "ops:media-cleanup": "node --import tsx scripts/maintenance.ts --apply",
    "ops:retention": "node --import tsx scripts/maintenance.ts --retention"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@next/env": "^16.4.2",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "better-auth": "^1.7.10",
    "bullmq": "^6.3.16",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "dotenv": "^18.0.8",
    "exceljs": "^4.4.0",
    "gsap": "^3.15.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "next-intl": "^4.14.9",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@electric-sql/pglite-socket": "^0.2.13",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prisma": "^7.10.1",
    "shadcn": "^4.22.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
